// kilo.jsonc — конфиг Kilo Code для этого проекта. Kilo читает его из корня репо.
// Модель по умолчанию уже задана. Права агента (блок "permission") вы вписываете
// руками в задании 1.3.2, MCP-сервер Playwright (блок "mcp") — в задании 1.6.3.
// Ключей и токенов здесь нет и не будет: ключ OpenRouter живёт только в настройках Kilo.
{
  "$schema": "https://app.kilo.ai/config.json",
  "model": "openrouter/minimax/minimax-m3",
  "permission": {
    "read": {
      "*": "allow",
      "*.env*": "deny"
    },
    "edit": {
      "*": "allow",
      "*.env*": "deny",
      "kilo.jsonc": "deny"
    },
    "bash": {
      "*": "ask",
      "git *": "allow",
      "git push*": "ask",
      "make *": "allow",
      "*.env*": "deny",
      "*reset_db*": "deny",
      "rm -rf*": "deny",
      "git push --force*": "deny"
    }
  },
  "agent": {
    "ask": {
      "permission": {
        "bash": {
          "ast-index stats": "allow",
          "ast-index --help": "allow",
          "ast-index search *": "allow",
          "ast-index class *": "allow",
          "ast-index symbol *": "allow",
          "ast-index usages *": "allow",
          "ast-index callers *": "allow"
        }
      }
    }
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest"
      ],
      "enabled": true
    }
  }
}